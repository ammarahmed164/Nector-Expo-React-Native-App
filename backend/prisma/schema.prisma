generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  phone     String?
  createdAt DateTime @default(now())

  orders            Order[]
  userInteractions  UserInteraction[]
  styleProfile      StyleProfile?
  chatConversations ChatConversation[]

  @@map("profiles")
}

model StoreInfo {
  id        String  @id @default(uuid())
  name      String
  address   String
  latitude  Float?
  longitude Float?
  openTime  String?
  closeTime String?

  @@map("store_info")
}

model Product {
  id            String      @id @default(uuid())
  name          String
  description   String?
  unit          String
  price         Decimal
  stockQuantity Int         @default(0)
  category      String
  imageUrl      String?
  createdAt     DateTime    @default(now())
  orderItems    OrderItem[]

  @@map("products")
}

enum FulfillmentType {
  delivery
  pickup
}

enum OrderStatus {
  pending
  accepted
  preparing
  out_for_delivery
  completed
  cancelled
}

model Order {
  id              String          @id @default(uuid())
  profileId       String
  profile         Profile         @relation(fields: [profileId], references: [id])
  fulfillmentType FulfillmentType
  deliverySlot    DateTime?
  pickupTime      DateTime?
  status          OrderStatus     @default(pending)
  totalAmount     Decimal
  paymentMethod   String
  createdAt       DateTime        @default(now())

  items OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal

  @@map("order_items")
}

model UserInteraction {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])
  type      String
  metadata  Json?
  createdAt DateTime @default(now())

  @@map("user_interactions")
}

model StyleProfile {
  id            String  @id @default(uuid())
  profileId     String  @unique
  profile       Profile @relation(fields: [profileId], references: [id])
  preferences   Json?
  dietaryTags   String[]

  @@map("style_profiles")
}

model ChatConversation {
  id        String   @id @default(uuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id])
  messages  Json
  createdAt DateTime @default(now())

  @@map("chat_conversations")
}
