PORT=4000

# Admin dashboard login (optional — defaults shown below)
ADMIN_EMAIL=ammarahmed2037@gmail.com
ADMIN_PASSWORD=ammar123$
DATABASE_URL=postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GEMINI_API_KEY=your-gemini-api-key
# SMS OTP mode: dev (code on screen) | production (Twilio/Bird)
SMS_MODE=dev

# Bird SMS (optional, when SMS_MODE=production)
BIRD_API_KEY=your-bird-api-key
BIRD_SMS_FROM=Nectar

# Legacy Bird Channels API (optional, old AccessKey format)
# BIRD_WORKSPACE_ID=
# BIRD_CHANNEL_ID=

# Supabase SMS Hook secret (set same value in Supabase Edge Function secrets)
# SEND_SMS_HOOK_SECRET=v1,whsec_your_generated_secret

# SMS OTP (Twilio fallback)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
